# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead.

# Port the server listens on. Render sets this automatically - you normally
# don't need to set it yourself on Render, only for local dev.
PORT=3000

# REQUIRED to use any /api/* route. Generate something random, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANAGEMENT_API_KEY=change-me-to-a-long-random-string

# --- Optional tuning (all have sane defaults if omitted) ---

# Default / max per-request timeout for webhook deliveries.
DEFAULT_TIMEOUT_MS=10000
MAX_TIMEOUT_MS=60000

# Hard caps so a misconfigured request can't runaway.
MAX_RETRIES_CAP=10
MAX_CONCURRENCY_CAP=25
MAX_TARGETS=20
MAX_PAYLOAD_BYTES=1048576

# Bounded in-memory history sizes (oldest items are dropped once full).
MAX_STORED_EVENTS=2000
MAX_STORED_DELIVERIES=4000
MAX_STORED_LIFECYCLES=1000

# Minimum allowed interval for the scheduler / poller, to prevent
# accidentally hammering your receiver.
SCHEDULER_MIN_INTERVAL_MS=2000
POLLING_MIN_INTERVAL_MS=2000
